        "proprietary_binaries_included": {"const": false},
        "authorization_tokens_included": {"const": false},
        "device_serials_included": {"const": false},
        "bluetooth_addresses_included": {"const": false},
        "media_payloads_included": {"const": false},
        "cloud_requests_performed": {"const": false},
