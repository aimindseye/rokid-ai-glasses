        "public_member_count": {"const": 594},
        "public_constructor_count": {"const": 56},
        "public_method_count": {"const": 429},
        "public_field_count": {"const": 106},
        "public_enum_constant_count": {"const": 3},
        "runtime_qualified_member_count": {"const": 9},
        "runtime_qualified_component_count": {"const": 2}
